# syntax=docker/dockerfile:1
# ============================================
# Rust — RocketMQ Client Test
# 国内源: RustCC crates 镜像
# ============================================
FROM rust:1.74-slim AS builder

# 配置 RustCC crates 镜像
RUN mkdir -p ~/.cargo && cat > ~/.cargo/config.toml <<'EOF'
[source.crates-io]
replace-with = 'rustcc'

[source.rustcc]
registry = "https://mirrors.rustcc.cn/crates.io-index.git"
EOF

WORKDIR /build

# 先拷贝 Cargo.toml 利用层缓存
COPY rust/Cargo.toml rust/Cargo.lock ./rust/
COPY rust/build.rs ./rust/

# 创建 dummy main 预下载依赖
RUN mkdir -p rust/src && echo "fn main(){}" > rust/src/main.rs \
    && cd rust && cargo build --release --examples || true

# 拷贝全部源码并编译 examples
COPY rust/ ./rust/
RUN cd rust && cargo build --release \
    --example producer \
    --example fifo_producer \
    --example delay_producer \
    --example transaction_producer \
    --example push_consumer \
    --example simple_consumer

# ---------- runtime ----------
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/rust/target/release/examples/producer /bin/
COPY --from=builder /build/rust/target/release/examples/fifo_producer /bin/
COPY --from=builder /build/rust/target/release/examples/delay_producer /bin/
COPY --from=builder /build/rust/target/release/examples/transaction_producer /bin/
COPY --from=builder /build/rust/target/release/examples/push_consumer /bin/
COPY --from=builder /build/rust/target/release/examples/simple_consumer /bin/
COPY docker/run-rust-test.sh /bin/

ENV ROCKETMQ_ENDPOINTS="127.0.0.1:8080"
ENV ROCKETMQ_ACCESS_KEY=""
ENV ROCKETMQ_SECRET_KEY=""

RUN chmod +x /bin/run-rust-test.sh

ENTRYPOINT ["/bin/run-rust-test.sh"]

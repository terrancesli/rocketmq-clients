# syntax=docker/dockerfile:1
# ============================================
# Python — RocketMQ Client Test
# 国内源: 阿里云 PyPI
# ============================================
FROM python:3.9-slim

# 配置 pip 阿里云镜像
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ \
    && pip config set global.trusted-host mirrors.aliyun.com

WORKDIR /app

# 安装运行时依赖
RUN pip install --no-cache-dir \
    grpcio grpcio-tools protobuf \
    opentelemetry-api opentelemetry-sdk opentelemetry-exporter-otlp-proto-grpc

# 拷贝 Python 客户端库并安装
COPY python/ ./python/
RUN cd python && pip install --no-cache-dir .

# 拷贝 all-demo 示例
COPY all-demo/python/example/ /app/examples/
COPY docker/run-python-test.sh /app/

ENV ROCKETMQ_ENDPOINT="127.0.0.1:8080"
ENV ROCKETMQ_ACCESS_KEY=""
ENV ROCKETMQ_SECRET_KEY=""

RUN chmod +x /app/run-python-test.sh

ENTRYPOINT ["/app/run-python-test.sh"]

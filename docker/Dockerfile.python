# syntax=docker/dockerfile:1
# ============================================
# Python — RocketMQ Client Test
# 国内源: 阿里云 PyPI
# ============================================
FROM python:3.9-slim AS builder

# 配置 pip 阿里云镜像
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ \
    && pip config set global.trusted-host mirrors.aliyun.com

WORKDIR /build
COPY python/ ./python/

# 安装 grpc 和 protobuf 工具
RUN cd python && pip install --no-cache-dir \
    grpcio grpcio-tools protobuf \
    opentelemetry-api opentelemetry-sdk opentelemetry-exporter-otlp-proto-grpc

# 生成 protobuf 代码
RUN cd python && python -m grpc_tools.protoc \
    -I../protos \
    --python_out=./python/rocketmq/grpc_protocol \
    --grpc_python_out=./python/rocketmq/grpc_protocol \
    ../protos/apache/rocketmq/v2/*.proto 2>/dev/null || true

# 安装 rocketmq 包
RUN cd python && pip install --no-cache-dir . || true

# ---------- runtime ----------
FROM python:3.9-slim

RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ \
    && pip config set global.trusted-host mirrors.aliyun.com

WORKDIR /app
COPY --from=builder /usr/local/lib/python3.9/site-packages /usr/local/lib/python3.9/site-packages
COPY python/ /app/python/
COPY all-demo/python/example/ /app/examples/
COPY docker/run-python-test.sh /app/

ENV ROCKETMQ_ENDPOINTS="127.0.0.1:8080"
ENV ROCKETMQ_ACCESS_KEY=""
ENV ROCKETMQ_SECRET_KEY=""
ENV PYTHONPATH="/app/python:/app"

RUN chmod +x /app/run-python-test.sh

ENTRYPOINT ["/app/run-python-test.sh"]
